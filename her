function initPDPHero(): void {
    const heroBlocks = document.querySelectorAll<HTMLElement>('.pdp-hero');

    if (!heroBlocks.length) return;

    heroBlocks.forEach((hero) => {
        const downloadBtn = hero.querySelector<HTMLAnchorElement>('.pdp-hero__download-btn.pdf-download');
        const videoWrapper = hero.querySelector<HTMLElement>('[data-pdp-hero-video-modal="true"]');

        bindDownload(downloadBtn);
        bindHeroVideoModal(videoWrapper);
    });
}

function bindDownload(downloadBtn: HTMLAnchorElement | null): void {
    if (!downloadBtn || downloadBtn.dataset.bound === 'true') return;

    downloadBtn.addEventListener('click', (e) => {
        e.preventDefault();
        window.print();
    });

    downloadBtn.dataset.bound = 'true';
}


// ==========================================
// PRODUCT HERO - CTA CLICK ANALYTICS
// ==========================================

const productHeroComponents = document.querySelectorAll(".pdp-hero");

productHeroComponents.forEach(hero => {

    const heroTitle =
        hero.querySelector(".pdp-hero__title")?.textContent.trim() || "NA";


    // Primary CTA (when PDF is not enabled) + Secondary CTA
    const ctas = hero.querySelectorAll(
        ".pdp-hero__download-btn:not(.pdf-download), .pdp-hero__secondary-cta"
    );


    ctas.forEach(cta => {

        cta.addEventListener("click", function () {

            let clickDestination = "";

            const href = this.getAttribute("href");

            if (href && href !== "#") {
                try {
                    clickDestination = new URL(
                        href,
                        window.location.origin
                    ).href;
                } catch (e) {
                    clickDestination = href;
                }
            }


            let clickType = "other";

            if (clickDestination) {
                try {
                    const url = new URL(clickDestination);

                    if (url.hostname !== window.location.hostname) {
                        clickType = "exit";
                    }

                } catch (e) {
                    clickType = "other";
                }
            }


            adobeDataLayer.push({
                event: adobeDataLayerEvents.component.linkClick,
                linkDetails: {
                    clickName: this.textContent.trim().toLowerCase(),
                    clickDestination: clickDestination,
                    clickLocation: "body",
                    clickType: clickType,
                    clickContext: heroTitle.toLowerCase(),
                    componentContext: "product hero"
                }
            });

        });

    });


    // PDF Download CTA
    const downloadBtn =
        hero.querySelector(".pdp-hero__download-btn.pdf-download");


    if (downloadBtn) {

        downloadBtn.addEventListener("click", function () {

            adobeDataLayer.push({
                event: adobeDataLayerEvents.component.linkClick,
                linkDetails: {
                    clickName: this.textContent.trim().toLowerCase(),
                    clickDestination: "",
                    clickLocation: "body",
                    clickType: "download",
                    clickContext: heroTitle.toLowerCase(),
                    componentContext: "product hero"
                }
            });

        }, true);

    }

});
