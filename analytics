(function () {
    "use strict";

    function isLumenHost(href) {
        // Treat relative URLs as internal; absolute URLs are checked by hostname.
        if (!href || href.startsWith("/")) {
            return true;
        }
        try {
            var url = new URL(href, window.location.origin);
            var host = url.hostname.toLowerCase();
            return host === "lumen.com" || host.endsWith(".lumen.com");
        } catch (e) {
            // If URL parsing fails, fall back to treating as external.
            return false;
        }
    }

    if (window.adobeDataLayer) {
        // Links
        const links = document.querySelectorAll('a');
        for (let i = 0; i < links.length; i++) {

            links[i].addEventListener('click', function (event) {
                let linkGrandParent = this.closest('.cmp-teaser__content');
                let parent = this.parentElement;
                let linkName = this.textContent.trim();
                let ariaLabel = this.getAttribute('aria-label');
                if (ariaLabel == 'Link to Homepage') {
                    linkName = 'Lumen Logo';
                }
                let linkClickType = "exit";
                if (this.getAttribute('href') != null) {
                    let href = this.getAttribute('href');
                    if (href.startsWith("/content/lumen") || isLumenHost(href)) {
                        linkClickType = "other";
                    }
                }
                let linkType = 'Link';
                let linkHref = this.getAttribute('href');
                let linkLocation = 'main container';
                let downloadType = 'AEM asset';
                let parentID = this.closest('[id]');
                let parentIDAtt = parentID.getAttribute('id').split('-')[0];
                let grandParentID = parentID.parentElement.closest('[id]');
                let grandParentIDAtt = grandParentID.getAttribute('id').split('-')[0];
                let teaserTitle;
                let industrySelectorContainer = this.closest('.industry-selector-container');
                let stackedContentTab = this.closest('.lumen-tabs__content');
                let industrySelectorItem = this.closest('.industry-selector-item');
                let industrySelectorTitle = industrySelectorItem ? industrySelectorItem.querySelector('.industry-selector-title') : null;
                const mediaHighlight = this.closest('.media_highlight');
                const solutionHighlight = this.closest('.solution-highlight');
                const subHeader = this.closest(".subheader-wrapper");
                const breadcrumbLink = this.closest(".breadcrumb");
                const featuredCard = this.closest(".cmp-featured-resources-card");
                const featuredResourcesSection = this.closest(".cmp-featured-resources");
                const subHeaderCTA = this.closest(".subheadernav-links");
                const conversionBanner = this.closest(".cmp-conversion-banner");
                const featuredResourcesTable = this.closest(".featuredresourcesTable__productCta");
                const productHero = this.closest(".pdp-hero");
                const resourceCard = this.closest(".resource-card");
                const marquee = this.closest(".marquee");
                const cdpHero = this.closest(".cdp-hero");

                // --- REGION DROPDOWN FIX ---
                const isRegionDropdown =
                    this.classList.contains('cmp-onelinknav__lang-link') &&
                    this.closest('.cmp-onelinknav__popover');

                if (isRegionDropdown) {
                    // Ensure clickName is the visible country text
                    linkName = this.textContent.trim();

                    // Per acceptance criteria
                    linkClickType = "other";
                    linkHref = ""; // clickDestination must be empty string
                }

                if (linkGrandParent) {
                    teaserTitle = linkGrandParent.querySelector('.cmp-teaser__pretitle') || linkGrandParent.querySelector('.cmp-teaser__title');
                }

                if (stackedContentTab) {
                    teaserTitle = stackedContentTab.querySelector('.lumen-tabs__title');
                }

                if (industrySelectorContainer) {
                    teaserTitle = industrySelectorContainer.querySelector('#selectedOption');
                }

                if (linkName === 'Larry' && linkGrandParent) {
                    const titleEl = linkGrandParent.querySelector('.cmp-teaser__title')
                    if (titleEl) {
                        linkName = titleEl.textContent.trim();
                    }
                }

                if (linkHref || isRegionDropdown) {

                    // Link Type
                    if (this.closest('.teaser')) {
                        if (this.closest('.teaser').classList.contains('lmn-light-teal-1')) {
                            linkType = 'Button';
                        } else if (this.closest('.teaser').classList.contains('lmn-secondary-1')) {
                            linkType = 'Button';
                        } else if (this.closest('.teaser').classList.contains('lmn-deep-orange-1')) {
                            linkType = 'Button';
                        } else if (this.closest('.teaser').classList.contains('lmn-goldenrod-1')) {
                            linkType = 'Button';
                        } else if (this.closest('.teaser').classList.contains('lmn-dark-teal-1')) {
                            linkType = 'Button';
                        }
                    }

                    if (parent.classList.contains('button') || parent.classList.contains('cmp-button') || parent.classList.contains('industry-selector-cta-containers')) {
                        linkType = 'Button';
                    }

                    // Link location
                    if (this.getAttribute('am-region')) {
                        linkLocation = this.getAttribute('am-region');
                    } else if (parent.getAttribute('am-region')) {
                        linkLocation = parent.getAttribute('am-region');
                    } else if (this.closest('#navigation') && this.getAttribute('aria-label') !== 'Link to Homepage') {
                        linkLocation = 'navigation bar';
                    } else if (this.closest('#navigation') && this.getAttribute('aria-label') == 'Link to Homepage') {
                        linkLocation = 'header';
                    } else if (this.closest('.cmp-experiencefragment--legal-footer') || this.closest('.cmp-experiencefragment--enterprise-portfolio-footer')) {
                        linkLocation = 'footer';
                    } else if (parentIDAtt && grandParentIDAtt && teaserTitle) {
                        linkLocation = teaserTitle.textContent.trim();
                    } else if (parentIDAtt && grandParentIDAtt) {
                        linkLocation = 'main container | ' + grandParentIDAtt + ' | ' + parentIDAtt;
                    }

                    if (industrySelectorContainer && industrySelectorTitle?.textContent) {
                        linkLocation = industrySelectorTitle.textContent.trim();
                    }

                    // Add name for footer links
                    if (linkHref.includes('twitter') || linkHref.includes('x.com')) {
                        linkName = 'Twitter/X Platform';
                    } else if (linkHref.includes('linkedin')) {
                        linkName = 'LinkedIn';
                    } else if (linkHref.includes('facebook')) {
                        linkName = 'Facebook';
                    } else if (linkHref.includes('youtube')) {
                        linkName = 'YouTube';
                    }

                    // Build full destination URL
                    let fullDestination = "NA";
                    if (linkHref) {
                        try {
                            fullDestination = new URL(linkHref, window.location.origin).href;
                        } catch (e) {
                            fullDestination = linkHref;
                        }
                    }

                   

                    if (cdpHero) {
                        let heroTitle = "";
                        const heroLayer = cdpHero.getAttribute("data-cmp-data-layer");
                        if (heroLayer) {
                            try {
                                const parsed = JSON.parse(heroLayer);
                                const key = Object.keys(parsed)[0];
                                heroTitle = parsed[key]?.title || "";
                            } catch (e) {
                                console.error("CDP Hero data layer parse error", e);
                            }
                        }

                        if (!heroTitle) {
                            heroTitle = cdpHero.querySelector(".cdp-hero__title")?.textContent.trim() || "";
                        }

                        const isDownload = this.classList.contains("cdp-hero__download-btn");
                        adobeDataLayer.push({
                            event: adobeDataLayerEvents.component.linkClick,
                            linkDetails: {
                                clickName: linkName.toLowerCase(),
                                clickDestination: isDownload ? "" : fullDestination,
                                clickLocation: "body",
                                clickType: isDownload ? "download" : linkClickType.toLowerCase(),
                                clickContext: heroTitle.toLowerCase(),
                                componentContext: "content detail hero"
                            }
                        });

                        return;
                    }

                    if(marquee){
                        const component = marquee.querySelector('.marquee_messageWrapper');
                        const primaryText = component?.querySelector('.marquee-primary_message')?.textContent?.trim() || '';
                        const marqueeCtaLink = component?.querySelector(".marquee_cta")?.getAttribute("href");
                        let fullDestination = "NA";
                        if (marqueeCtaLink) {
                            try {
                                fullDestination = new URL(marqueeCtaLink, window.location.origin).href;
                            } catch (e) {
                                fullDestination = marqueeCtaLink;
                            }
                        }
                        adobeDataLayer.push({
                            event: adobeDataLayerEvents.component.linkClick,
                            linkDetails: {
                                clickName: (this.textContent || '').trim().toLowerCase(),
                                clickDestination: fullDestination,
                                clickLocation: 'header',
                                clickType: 'other',
                                clickContext: primaryText.toLowerCase(),
                                componentContext: "marquee",
                            }
                        })
                        return;
                    }

                    // -----------------------------
                    // Product Solution Hero
                    // -----------------------------
                    if (productHero) {
                        let heroTitle = "";
                        const heroLayer = productHero.getAttribute("data-cmp-data-layer");

                        if (heroLayer) {
                            try {
                                const parsed = JSON.parse(heroLayer);
                                const key = Object.keys(parsed)[0];
                                heroTitle = parsed[key]?.title || "";
                            } catch (e) {
                                console.error("Product Hero data layer parse error", e);
                            }
                        }

                        // Fallback to the DOM only if the JSON lookup came back empty
                        if (!heroTitle) {
                            heroTitle = productHero.querySelector(".pdp-hero__title")?.textContent.trim() || "";
                        }

                        const isDownload = this.classList.contains("pdf-download");

                        adobeDataLayer.push({
                            event: adobeDataLayerEvents.component.linkClick,
                            linkDetails: {
                                clickName: linkName.toLowerCase(),
                                clickDestination: isDownload ? "" : fullDestination,
                                clickLocation: "body",
                                clickType: isDownload ? "download" : linkClickType.toLowerCase(),
                                clickContext: heroTitle.toLowerCase(),
                                componentContext: "product-solution hero"
                            }
                        });

                        return;
                    }

                    // -----------------------------
                    // Contact Us Cards
                    // -----------------------------
                    if (this.closest(".contact-us-component")) {
                        return;
                    }

                    // Download links
                    if (linkHref.match("assets.lumen.com")) {

                        // Determine filename
                        const fileNameArray = linkHref.split('/');
                        const fileNameArrayComp = fileNameArray.length - 1;
                        for (let i = 0; i < fileNameArray.length; i++) {

                            if (i == fileNameArrayComp) {
                                let fileNameTitle = fileNameArray[i].replaceAll('-', ' ').split('?')[0].split(' ');

                                for (let i = 0; i < fileNameTitle.length; i++) {
                                    fileNameTitle[i] = fileNameTitle[i][0].toUpperCase() + fileNameTitle[i].substring(1);
                                }

                                fileNameTitle = fileNameTitle.toString().replaceAll(',', ' ');
                                downloadDataLayer(fileNameTitle);
                            }
                        }

                        // Determine download type
                        if (linkHref.includes('.pdf')) {
                            downloadType = 'pdf';
                        } else if (linkHref.includes('.xls')) {
                            downloadType = 'xls';
                        } else if (linkHref.includes('.mp3')) {
                            downloadType = 'mp3';
                        } else if (linkHref.includes('.exe')) {
                            downloadType = 'exe';
                        } else if (linkHref.includes('.zip')) {
                            downloadType = 'zip';
                        } else if (linkHref.includes('.wav')) {
                            downloadType = 'wav';
                        } else if (linkHref.includes('.mov')) {
                            downloadType = 'mov';
                        } else if (linkHref.includes('.mpg')) {
                            downloadType = 'mpg';
                        } else if (linkHref.includes('.avi')) {
                            downloadType = 'avi';
                        } else if (linkHref.includes('.wmv')) {
                            downloadType = 'wmv';
                        } else if (linkHref.includes('.docx')) {
                            downloadType = 'docx';
                        } else if (linkHref.includes('.doc')) {
                            downloadType = 'doc';
                        } else if (linkHref.includes('.xlsx')) {
                            downloadType = 'xlsx';
                        } else if (linkHref.includes('.xls')) {
                            downloadType = 'xls';
                        } else if (linkHref.includes('.pptx')) {
                            downloadType = 'pptx';
                        } else if (linkHref.includes('.ppt')) {
                            downloadType = 'ppt';
                        }

                        function downloadDataLayer(title) {
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.fileDownload,
                                linkDetails: {
                                    clickName: linkName,
                                    clickType: 'download',
                                    clickDestination: linkHref,
                                    clickLocation: linkLocation,
                                    fileDownload: {
                                        filename: title,
                                        type: downloadType,
                                    }
                                }
                            });
                        }

                        // Normal links
                    } else {

                        let componentContextValue;
                        let clickContextValue;
                        // -----------------------------
                        // Media Highlight
                        // -----------------------------
                        if (mediaHighlight) {
                            const mediaTitle = mediaHighlight.querySelector(".title")?.textContent.trim() || "";
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: mediaTitle.toLowerCase(),
                                    componentContext: "media-highlight"
                                }
                            });

                            return;
                        }
                        // -----------------------------
                        // Conversion Banner
                        // -----------------------------
                        else if (conversionBanner) {
                            const conversionBannerTitle = conversionBanner.querySelector(".cmp-conversion-banner__title")?.textContent.trim() || "";
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: conversionBannerTitle.toLowerCase(),
                                    componentContext: "conversion banner"
                                }
                            });

                            return;
                        }

                        // -----------------------------
                        // Solution Highlight
                        // -----------------------------
                        else if (solutionHighlight) {
                            const solutionContext = solutionHighlight.querySelector(".solution-highlight__label")
                                ?.textContent.trim() || "";
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: solutionContext.toLowerCase(),
                                    componentContext: "solution-highlight"
                                }
                            });

                            return;
                        }
                        // ---------------------------------------------
                        // Subheader Breadcrumb + CTA
                        // ---------------------------------------------
                        else if (subHeader && (breadcrumbLink || subHeaderCTA)) {

                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "header",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: "subheader",
                                    componentContext: "subheader-navigation"
                                }
                            });

                            return;
                        }

                        // -----------------------------
                        // Featured Card
                        // -----------------------------

                        else if (featuredCard || featuredResourcesSection) {
 
                            let productTitle = "";
                            let componentContextValue = "featured-card";
 
                            if (featuredCard) {
                                const featuredCardLayer = featuredCard.getAttribute("data-cmp-data-layer");
                                let featuredCardInfo = {};
 
                                if (featuredCardLayer) {
                                    try {
                                        const parsed = JSON.parse(featuredCardLayer);
                                        const key = Object.keys(parsed)[0];
                                        featuredCardInfo = parsed[key] || {};
                                    } catch (e) {
                                        console.error("Featured Card data layer parse error", e);
                                    }
                                }
 
                                productTitle =
                                    featuredCardInfo.productTitle ||
                                    featuredCard.querySelector(".cmp-featured-resources-card__title")
                                        ?.textContent.trim() ||
                                    "";
                                componentContextValue = featuredCardInfo.componentName || "featured-card";
                            } else {
                                productTitle =
                                    featuredResourcesSection.querySelector(".cmp-featured-resources__title")
                                        ?.textContent.trim() || "";
                                
                            }
 
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: productTitle.toLowerCase(),
                                    componentContext: componentContextValue
                                }
                            });
 
                            return;
                        }

                        // -----------------------------
                        // Featured Resources Table
                        // -----------------------------
                        else if (featuredResourcesTable) {
                            const productHeader = this.closest("th, td");

                            const productTitle =
                                productHeader
                                    ?.querySelector(".featuredresourcesTable__productTitle")
                                    ?.textContent.trim() || "";

                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: productTitle.toLowerCase(),
                                    componentContext: "featured resources - table"
                                }
                            });

                            return;
                        }

                         // -----------------------------
                        // Resources Card
                        // -----------------------------
                        else if (resourceCard) {
                            const resourceCardTitle = resourceCard.querySelector(".resource-card__title")?.textContent.trim() || "";
                            const clickName = resourceCard.querySelector(".resource-card__cta")?.textContent.trim() || "";
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: clickName.toLowerCase(),
                                    clickDestination: fullDestination.toLowerCase(),
                                    clickLocation: "body",
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: resourceCardTitle.toLowerCase(),
                                    componentContext: "resources card"
                                }
                            });

                            return;
                        }


                        else {
                            // Existing Default
                            adobeDataLayer.push({
                                event: adobeDataLayerEvents.component.linkClick,
                                linkDetails: {
                                    clickName: linkName.toLowerCase(),
                                    clickElementType: linkType.toLowerCase(),
                                    clickDestination: (linkHref || "").toLowerCase(),
                                    clickLocation: linkLocation.toLowerCase(),
                                    clickType: linkClickType.toLowerCase(),
                                    clickContext: clickContextValue,
                                    componentContext: componentContextValue
                                }
                            });
                        }
                    }
                }
            });
        }



        // ==========================================
        // LOOKUP FORM – SEARCH + CTA EVENTS
        // ==========================================

        const lookupForms = document.querySelectorAll(".lookup-form");

        lookupForms.forEach(form => {

            const searchBtn = form.querySelector(".lookup-form__search-label");
            const titleEl = form.querySelector(".lookup-form__title h2");
            const componentTitle = titleEl?.textContent.trim() || "NA";

            // -----------------------------
            // SEARCH BUTTON CLICK
            // -----------------------------
            if (searchBtn) {
                searchBtn.addEventListener("click", () => {

                    const clickName = searchBtn.textContent.trim().toLowerCase();
                    const clickDestination = "NA"; // Search triggers JS, not navigation

                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName,
                            clickDestination,
                            clickLocation: "body",
                            clickType: "other",
                            clickContext: componentTitle.toLowerCase(),
                            componentContext: "lookup form"
                        }
                    });
                });
            }

            // -----------------------------
            // CTA BUTTONS (Primary, Contact, Secondary)
            // -----------------------------
            const ctas = form.querySelectorAll(
                ".lookup-form__primary-cta, .lookup-form__contact-cta, .lookup-form__secondary-cta"
            );

            ctas.forEach(cta => {
                cta.addEventListener("click", () => {

                    const clickName = cta.textContent.trim().toLowerCase();

                    // Build full destination URL
                    let rawHref = cta.getAttribute("href") || cta.getAttribute("data-link") || cta.getAttribute("data-href");
                    let clickDestination = "NA";

                    if (rawHref) {
                        try {
                            clickDestination = new URL(rawHref, window.location.origin).href;
                        } catch (e) {
                            clickDestination = rawHref;
                        }
                    }

                    // Determine search result context (success or error message)
                    const successMsg = form.querySelector(".lookup-form__success");
                    const errorMsg = form.querySelector(".lookup-form__error");

                    let clickContext = componentTitle.toLowerCase();

                    if (successMsg && successMsg.style.display !== "none") {
                        clickContext = successMsg.textContent.trim().toLowerCase();
                    } else if (errorMsg && errorMsg.style.display !== "none") {
                        clickContext = errorMsg.textContent.trim().toLowerCase();
                    }

                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName,
                            clickDestination,
                            clickLocation: "body",
                            clickType: "other",
                            clickContext,
                            componentContext: "lookup form"
                        }
                    });
                });
            });

        });


        // ==========================================
        // FEATURED RESOURCES – INFORMATION TOGGLE
        // ==========================================
        const resourcesInfoComponents = document.querySelectorAll(".featured-resources-information");

        resourcesInfoComponents.forEach(component => {
            const toggle = component.querySelector(".cmp-featured-resources-info__toggle");

            if (!toggle) return;

            toggle.addEventListener("click", () => {

                const titleEl = component.querySelector(".cmp-featured-resources-info__title");
                const title = titleEl?.textContent.trim() || "NA";

                // Determine expand/collapse state
                const isExpanded = toggle.getAttribute("aria-expanded") === "true";
                let clickState = isExpanded ? "collapse" : "expand";

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: title.toLowerCase(),
                        clickDestination: "NA",
                        clickLocation: "body",
                        clickType: "other",
                        clickContext: title.toLowerCase(),
                        componentContext: "featured resources - information",
                        clickState: clickState
                    }
                });
            });
        });

        // ==========================================
        // CONVERSION BANNER – PRIMARY CTA BUTTON
        // ==========================================
        const conversionBanners = document.querySelectorAll(".conversion-banner");

        conversionBanners.forEach(banner => {
            const primaryCTA = banner.querySelector(".cmp-conversion-banner__cta--primary");

            if (!primaryCTA) return;

            primaryCTA.addEventListener("click", () => {

                const titleEl = banner.querySelector(".cmp-conversion-banner__title");
                const bannerTitle = titleEl?.textContent.trim() || "NA";

                const clickName = primaryCTA.textContent.trim().toLowerCase();

                // Primary CTA buttons often navigate via JS → no href
                const clickDestination = "NA";

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: clickName,
                        clickDestination: clickDestination,
                        clickLocation: "body",
                        clickType: "other",
                        clickContext: bannerTitle.toLowerCase(),
                        componentContext: "conversion banner"
                    }
                });
            });
        });

        // ==========================================
        // CONTACT US – ACTION CTA
        // ==========================================
        if (!window.__contactUsCtaBound) {
            document.addEventListener("click", function (event) {

                const cta = event.target.closest(
                    ".contact-us-component .cmp-teaser__action-link, .contact-us-component .chat-cta"
                );

                if (!cta) return;

                const sectionRoot = cta.closest(".contact-us-component");
                const sectionTitleEl = sectionRoot?.querySelector(".cmp-teaser__title");
                const sectionTitle = sectionTitleEl?.textContent.trim() || "NA";

                const clickName = cta.closest(".card")?.querySelector(".cmp-teaser__title")?.textContent?.trim()?.toLowerCase() || "na";
                const rawHref = cta.getAttribute("href") || cta.getAttribute("data-href") || "";
                let clickDestination = "NA";

                if (rawHref) {
                    try {
                        clickDestination = new URL(rawHref, window.location.origin).href;
                    } catch (e) {
                        clickDestination = rawHref;
                    }
                }

                let clickType = "other";
                if (rawHref) {
                    clickType = (rawHref.startsWith("/content/lumen") || isLumenHost(rawHref)) ? "other" : "exit";
                }

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: clickName,
                        clickDestination: clickDestination.toLowerCase(),
                        clickLocation: "body",
                        clickType: clickType,
                        clickContext: sectionTitle.toLowerCase(),
                        componentContext: "contact us"
                    }
                });
            });

            window.__contactUsCtaBound = true;
        }

         // ==========================================
        // FEATURED RESOURCES CARD – BUTTON CTA
        // ==========================================
        const featuredResourceCards = document.querySelectorAll(".cmp-featured-resources-card");
 
        featuredResourceCards.forEach(card => {
 
            const buttonCta = card.querySelector(".featurecard-modal-popup");
 
            if (!buttonCta) return;
 
            buttonCta.addEventListener("click", () => {
 
                const titleEl = card.querySelector(".cmp-featured-resources-card__title");
                const productTitle = titleEl?.textContent.trim() || "NA";
 
                const clickName = buttonCta.textContent.trim().toLowerCase();
 
                // Modal-triggering buttons navigate via JS → no real href
                const rawHref = buttonCta.getAttribute("data-href") || "";
                let clickDestination = "NA";
 
                if (rawHref) {
                    try {
                        clickDestination = new URL(rawHref, window.location.origin).href;
                    } catch (e) {
                        clickDestination = rawHref;
                    }
                }
 
                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: clickName,
                        clickDestination: clickDestination.toLowerCase(),
                        clickLocation: "body",
                        clickType: "other",
                        clickContext: productTitle.toLowerCase(),
                        componentContext: "featured-card"
                    }
                });
            });
        });

        const featuredResourcesTableAccordionComponents = document.querySelectorAll(".featuredresourcesTable");

        featuredResourcesTableAccordionComponents.forEach((component) => {

            const accordionToggle = component.querySelector(".featuredresourcesTable__accordionToggle");

            if (!accordionToggle) {
                return;
            }

            accordionToggle.addEventListener("click", () => {

                const title =
                    component.querySelector(".featuredresourcesTable__title")
                        ?.textContent.trim() || "NA";

                const isExpanded =
                    accordionToggle.getAttribute("aria-expanded") === "true";

                const clickState = isExpanded ? "collapse" : "expand";

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: title.toLowerCase(),
                        clickDestination: "NA",
                        clickLocation: "body",
                        clickType: "other",
                        clickContext: title.toLowerCase(),
                        componentContext: "featured resources - table",
                        clickState
                    }
                });

            });

        });

        // ==========================================
        // FEATURED RESOURCES TABLE
        // ==========================================
        const resourcesTableComponents = document.querySelectorAll(".featuredresourcesTable");
 
        resourcesTableComponents.forEach(component => {
 
            const componentContextValue = "featured resources - table";
 
            function pushStandardLinkClick(linkName, linkHref, clickContextValue) {
 
                let clickType = "other";
                let clickDestination = "NA";
 
                if (linkHref) {
                    clickType = (linkHref.startsWith("/content/lumen") || isLumenHost(linkHref)) ? "other" : "exit";
                    try {
                        clickDestination = new URL(linkHref, window.location.origin).href;
                    } catch (e) {
                        clickDestination = linkHref;
                    }
                }
 
                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: linkName.toLowerCase(),
                        clickDestination: clickDestination,
                        clickLocation: "body",
                        clickType: clickType,
                        clickContext: clickContextValue.toLowerCase(),
                        componentContext: componentContextValue
                    }
                });
            }
 
            component.addEventListener("click", function (event) {
 
                const titleEl = component.querySelector(".featuredresourcesTable__title");
                const componentTitle = titleEl?.textContent.trim() || "NA";
                const toggleWrapper = event.target.closest(".featuredresourcesTable__toggleWrapper");
                if (toggleWrapper) {
 
                    const toggleEl = toggleWrapper.querySelector(".featuredresourcesTable__toggle");
                    const toggleLabelEl = toggleWrapper.querySelector(".featuredresourcesTable__keyDiffText");
                    const toggleLabel = toggleLabelEl?.textContent.trim() || "NA";
 
                    const isOn = toggleEl?.getAttribute("data-state") === "true";
                    const clickState = isOn ? "off" : "on";
 
                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: toggleLabel.toLowerCase(),
                            clickDestination: "NA",
                            clickLocation: "body",
                            clickType: "other",
                            clickContext: componentTitle.toLowerCase(),
                            componentContext: componentContextValue,
                            clickState: clickState
                        }
                    });
                    return;
                }
 
                const columnsToggle = event.target.closest(".featuredresourcesTable__ctaText");
                if (columnsToggle) {
                    pushStandardLinkClick(columnsToggle.textContent.trim(), null, componentTitle);
                    return;
                }
            });
 
         
        });
 

        // ==============================
        // SUBHEADER
        // ==============================
        const subheaderContainer = document.querySelector(".pdp-subheadernav");
        if (subheaderContainer) {
            subheaderContainer.addEventListener("click", function (event) {
                const item = event.target.closest(".subheadernav-item");
                if (!item) return;

                const linkName = item.textContent.trim();
                const dataTarget = item.getAttribute("data-target") || "";
                const formattedTarget = dataTarget.trim().toLowerCase().replace(/\s+/g, "-");
                const destination = formattedTarget ? `${window.location.origin}${window.location.pathname}#${formattedTarget}` : "NA";
                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.linkClick,
                    linkDetails: {
                        clickName: linkName.toLowerCase(),
                        clickDestination: destination,
                        clickLocation: "header",
                        clickType: "other",
                        clickContext: "subheader",
                        componentContext: "subheader-navigation"
                    }
                });
            });

            // MOBILE dropdown support
            const mobileDropdown = subheaderContainer.querySelector(".subheadernav-mobile-dropdown");
            if (mobileDropdown) {
                mobileDropdown.addEventListener("click", function (event) {

                    const item = event.target.closest(".subheadernav-item");
                    const dataTarget = item.getAttribute("data-target") || "";
                    const formattedTarget = dataTarget.trim().toLowerCase().replace(/\s+/g, "-");
                    const destination = formattedTarget ? `${window.location.origin}${window.location.pathname}#${dataTarget}` : "NA";
                    if (!item) return;
                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: item.textContent.trim().toLowerCase(),
                            clickDestination: destination.toLowerCase(),
                            clickLocation: "header",
                            clickType: "other",
                            clickContext: "subheader",
                            componentContext: "subheader-navigation"
                        }
                    });
                });
            }
             }

            // CDP Hero - Share Button
            // -----------------------------
            const shareButtons = document.querySelectorAll(".cdp-hero__share-btn");

            shareButtons.forEach((btn) => {
                btn.addEventListener("click", function () {

                    const cdpHero = btn.closest(".cdp-hero");

                    let heroTitle = "";
                    const heroLayer = cdpHero?.getAttribute("data-cmp-data-layer");

                    if (heroLayer) {
                        try {
                            const parsed = JSON.parse(heroLayer);
                            const key = Object.keys(parsed)[0];
                            heroTitle = parsed[key]?.title || "";
                        } catch (e) {}
                    }

                    if (!heroTitle) {
                        heroTitle = cdpHero?.querySelector(".cdp-hero__title")?.textContent.trim() || "";
                    }

                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: "share",
                            clickDestination: "",
                            clickLocation: "body",
                            clickType: "other",
                            clickContext: heroTitle.toLowerCase(),
                            componentContext: "content detail hero"
                        }
                    });
                });
            });

            // -----------------------------
            // CDP Hero - Anchor Links
            // -----------------------------
            const heroAnchorButtons = document.querySelectorAll(".cdp-hero__anchor-link");

            heroAnchorButtons.forEach((btn) => {
                btn.addEventListener("click", function () {

                    const cdpHero = btn.closest(".cdp-hero");
                    let heroTitle = "";
                    const heroLayer = cdpHero?.getAttribute("data-cmp-data-layer");

                    if (heroLayer) {
                        try {
                            const parsed = JSON.parse(heroLayer);
                            const key = Object.keys(parsed)[0];
                            heroTitle = parsed[key]?.title || "";
                        } catch (e) {}
                    }

                    if (!heroTitle) {
                        heroTitle = cdpHero.querySelector(".cdp-hero__title")?.textContent.trim() || "";
                    }

                    const target = btn.getAttribute("data-target") || "";

                    const destination = target
                        ? `${window.location.origin}${window.location.pathname}#${target}`
                        : "";

                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: btn.textContent.trim().toLowerCase(),
                            clickDestination: destination,
                            clickLocation: "body",
                            clickType: "other",
                            clickContext: heroTitle.toLowerCase(),
                            componentContext: "content detail hero"
                        }
                    });
                });
            });




        // Sign In Button

        const signInBtn = document.querySelector('button.signInButton');
        if (signInBtn) {
            const signInBtnOverride = signInBtn.getAttribute('data-linkOverride');
            signInBtn.addEventListener('click', function (event) {
                adobeDataLayer.push({
                    event: adobeDataLayerEvents?.component.linkClick,
                    linkDetails: {
                        clickName: 'sign in',
                        clickElementType: 'button',
                        clickDestination: (signInBtnOverride ? signInBtnOverride : "sign in authentication"),
                        clickLocation: 'header',
                        clickType: 'other'
                    }
                });
            });
        }

        function pushAdobeDataLayerForDropdown(optionName) {
            const industryEybrowText = document.querySelector('.industry-selector-eybrow-text');
            optionName = optionName ? optionName.trim() : optionName;
            adobeDataLayer.push({
                event: adobeDataLayerEvents.component.linkClick,
                linkDetails: {
                    clickDestination: '',
                    clickLocation: industryEybrowText.textContent.toLocaleLowerCase(),
                    clickName: 'industry dropdown|' + optionName.toLowerCase(),
                    clickElementType: 'button',
                    clickType: 'other'
                }
            });
        }

        // Industry Selector Dropdown Analytics
        const dropdownHeader = document.getElementById('dropdownHeader');
        const dropdownList = document.getElementById('dropdownList');
        if (dropdownHeader && dropdownList) {
            dropdownHeader.addEventListener('click', function (event) {
                const isOpen = dropdownHeader.classList.contains('open');
                pushAdobeDataLayerForDropdown(isOpen ? 'collapse' : 'expand');
            });

            dropdownList.addEventListener('click', function (event) {
                pushAdobeDataLayerForDropdown(event.target.textContent);
            });
        }

        // ==========================================
        // ACCORDION (CDP / core cmp-accordion) – CHEVRON TOGGLE
        // ==========================================
        const cdpAccordions = document.querySelectorAll(".cmp-accordion");

        cdpAccordions.forEach(accordion => {
            if (accordion.closest(".cmp-faq-agentic")) return;

            const accordionLayer = accordion.getAttribute("data-cmp-data-layer");
            let componentName = "accordion";

            if (accordionLayer) {
                try {
                    const parsed = JSON.parse(accordionLayer);
                    const key = Object.keys(parsed)[0];
                    componentName = parsed[key]?.componentName || componentName;
                } catch (e) {
                    console.error("Accordion data layer parse error", e);
                }
            }


            const buttons = accordion.querySelectorAll(".cmp-accordion__button");

            buttons.forEach(button => {

                if (button.dataset.accordionAnalyticsBound === "true") return;

                button.addEventListener("click", () => {

                    const titleEl = button.querySelector(".cmp-accordion__title");
                    const title = titleEl?.textContent.trim() || "NA";
                    const isExpanded = button.getAttribute("aria-expanded") === "true";
                    const clickState = isExpanded ? "collapse" : "expand";

                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: title.toLowerCase(),
                            clickDestination: "NA",
                            clickLocation: "body",
                            clickType: "other",
                            clickContext: 'faq',
                            clickState: clickState,
                            componentContext: componentName
                        }
                    });
                });

                button.dataset.accordionAnalyticsBound = "true";
            });
        });

        // FAQ Component Analytics
        const faqButtons = document.querySelectorAll('.cmp-faq-agentic__cta');
        if (faqButtons.length) {
            faqButtons.forEach((btn) => {
                btn.addEventListener('click', function () {
                    const component = btn.closest('.cmp-faq-agentic');
                    const titleText = component?.querySelector('.cmp-faq-agentic__title')?.textContent?.trim() || '';
                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: (btn.textContent || '').trim().toLowerCase(),
                            clickDestination: 'NA',
                            clickLocation: 'body',
                            clickType: 'other',
                            clickContext: titleText.toLowerCase(),
                            componentContext: "faqs",
                        }
                    });
                });
            });
        }

        const faqOptions = document.querySelectorAll('.cmp-faq-agentic__right .cmp-accordion__header .cmp-accordion__button');
        if (faqOptions.length) {
            faqOptions.forEach((optionBtn) => {
                optionBtn.addEventListener('click', function () {
                    const component = this.closest('.cmp-faq-agentic');
                    const titleText = component?.querySelector('.cmp-faq-agentic__title')?.textContent?.trim() || '';
                    const wasExpanded = this.getAttribute('aria-expanded') === 'true';
                    adobeDataLayer.push({
                        event: adobeDataLayerEvents.component.linkClick,
                        linkDetails: {
                            clickName: (this.textContent || '').trim().toLowerCase(),
                            clickDestination: 'NA',
                            clickLocation: 'body',
                            clickType: 'other',
                            clickContext: titleText.toLowerCase(),
                            componentContext: "faqs",
                            clickState: wasExpanded ? "collapse" : "expand",
                        }
                    });
                }, true);
            });
        }

        // Chat Transcript
        const chatSaveTranscript = document.querySelector('#downloadBtn');
        if (chatSaveTranscript) {
            chatSaveTranscript.addEventListener('click', function (event) {
                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.fileDownload,
                    linkDetails: {
                        clickName: 'save transcript',
                        clickType: 'download',
                        clickDestination: 'transcript.txt',
                        clickLocation: 'lumen chat dialog box',
                        fileDownload: {
                            filename: 'transcript of chat session',
                            type: 'txt'
                        }
                    }
                });
            });
        }

        // Forms
        function trackForms() {
            try {
                MktoForms2.whenReady(function (form) {
                    const fields = document.querySelectorAll('.mktoField');
                    const pageTitle = document.querySelector('title') ? document.querySelector('title').textContent : 'Page Title Unavailable';
                    const formID = form.getId() ? 'mktoForm_' + form.getId().toString() : 'Form ID Unavailable';
                    let counter = 1;

                    // Form Start
                    for (let i = 0; i < fields.length; i++) {
                        if (fields[i]?.type !== 'hidden') {
                            fields[i].addEventListener('focus', function (event) {
                                if (counter == 1) { // Fire only once per page load
                                    adobeDataLayer.push({
                                        event: adobeDataLayerEvents.component.formStart,
                                        details: {
                                            formName: pageTitle + ': ' + formID,
                                            formID: formID
                                        }
                                    });
                                    counter++;
                                }
                            });
                        }
                    }

                    // Form Error
                    form.onValidate(function (nativeValid) {
                        if (!nativeValid) {
                            setTimeout(function () { // Wait half a second so that the mktoErrorMsg html will be added first
                                let mktoError = document.querySelector('.mktoErrorMsg');
                                if (mktoError) {
                                    let mktoErrorMsg = mktoError.textContent;
                                    let mktoErrorField = mktoError.getAttribute('id');
                                    adobeDataLayer.push({
                                        event: adobeDataLayerEvents.component.formError,
                                        details: {
                                            formName: pageTitle + ': ' + formID,
                                            formID: formID,
                                            formError: mktoErrorField + ': ' + mktoErrorMsg
                                        }
                                    });
                                }
                            }, 500);
                        }
                    });

                    // Form Submit
                    form.onSuccess(function (valsObj, destStr) {
                        const email = valsObj?.Email || valsObj?.email || valsObj?.userEmail || '';
                        adobeDataLayer.push({
                            event: adobeDataLayerEvents.component.formSubmit,
                            details: {
                                formName: pageTitle + ': ' + formID,
                                formID: formID,
                                emailID: email
                            }
                        });
                    });
                });
            }
            catch (e) {
                console.log('Error in trackForms: ', e);
            }
        }

        if (typeof MktoForms2 !== 'undefined') {
            trackForms();
        } else {
            window.addEventListener("mkto-script-loaded", (e) => {
                trackForms();
            }, false,
            );
        }

        // Chat
        const chatLink = document.querySelector("a[href='#chat']");
        let chatClickName = 'Chat';
        let chatClickType = 'Button';
        let chatClickDestination = 'launchChat';
        let newUser = 'new';

        if (chatLink) {
            chatLink.addEventListener('click', function (event) {
                chatClickName = chatLink.textContent.trim();
                chatClickType = 'Link';
                chatClickDestination = '#chat';
            });
        }

        // Chat Initiated event for Salesforce Embedded Messaging
        window.addEventListener("onEmbeddedMessagingConversationStarted", function (event) {
            try {
                window.adobeDataLayer = window.adobeDataLayer || [];
                let conversationId = event?.detail?.conversationId || "";

                if (sessionStorage.getItem('com.lumen.mkplv2..customerInfo.1')) {
                    newUser = 'Registered member';
                }

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.chatInitiated,
                    linkDetails: {
                        clickName: chatClickName,
                        clickType: chatClickType,
                        clickDestination: chatClickDestination,
                        clickLocation: 'main container'
                    },
                    chat: {
                        sessionID: conversationId
                    },
                    user: {
                        type: newUser
                    }
                });
            } catch (e) {
                console.log("[AEP Utils] - Error handling chat conversation started.", e);
            }
        });

        // Chat Terminated event for Salesforce Embedded Messaging
        window.addEventListener("onEmbeddedMessagingConversationClosed", function (event) {
            try {
                window.adobeDataLayer = window.adobeDataLayer || [];
                let conversationId = event?.detail?.conversationId || "";

                if (sessionStorage.getItem('com.lumen.mkplv2..customerInfo.1')) {
                    newUser = 'Registered member';
                }

                adobeDataLayer.push({
                    event: adobeDataLayerEvents.component.chatTerminated,
                    linkDetails: {
                        clickName: 'end chat',
                        clickType: 'user',
                        clickLocation: 'chat'
                    },
                    chat: {
                        sessionID: conversationId
                    },
                    user: {
                        type: newUser
                    }
                });
            } catch (e) {
                console.log("[AEP Utils] - Error handling chat conversation closed.", e);
            }
        });
    }
