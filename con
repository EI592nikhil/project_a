// ==============================
		// SUBHEADER TRACKING (CORRECT PLACE)
		// ==============================

		const subheaderContainer = document.querySelector(".pdp-subheadernav");

		if (subheaderContainer) {

			subheaderContainer.addEventListener("click", function (event) {

				const item = event.target.closest(".subheadernav-item");
				if (!item) return;

				const linkName = item.textContent.trim();
				const dataTarget = item.getAttribute("data-target") || "";

				adobeDataLayer.push({
					event: adobeDataLayerEvents.component.linkClick,
					linkDetails: {
						clickName: linkName,
						clickElementType: "button",
						clickDestination: dataTarget,   // IMPORTANT: use section id
						clickLocation: "header",
						clickType: "other",
						clickContext: "subheader",
						componentContext: "subheader navigation"
					}
				});
			});

			// MOBILE dropdown support
			const mobileDropdown = subheaderContainer.querySelector(".subheadernav-mobile-dropdown");

			if (mobileDropdown) {
				mobileDropdown.addEventListener("click", function (event) {

					const item = event.target.closest(".subheadernav-item");
					if (!item) return;

					adobeDataLayer.push({
						event: adobeDataLayerEvents.component.linkClick,
						linkDetails: {
							clickName: item.textContent.trim(),
							clickElementType: "button",
							clickDestination: item.getAttribute("data-target") || "",
							clickLocation: "header",
							clickType: "other",
							clickContext: "subheader",
							componentContext: "subheader navigation"
						}
					});
				});
			}
		}
