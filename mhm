<sly data-sly-test="${wcmmode.edit && !model.title}">
    <div class="cq-placeholder" data-emptytext="${component.title}"></div>
</sly>
<sly data-sly-use.model="com.centurylink.aem.core.models.ProductSolutionHeroModel" />

<section class="pdp-hero" id="${model.id}" data-cmp-data-layer="${model.data}">
    <div class="pdp-hero__wrapper ${model.subheaderClass}">
        <div class="pdp-hero__content">
            <div class="pdp-hero__eyebrow">
                ${model.eyebrow}
            </div>
            <h1 class="pdp-hero__title">${model.title}</h1>
            <div class="pdp-hero__description">
                ${model.description @context='html'}
            </div>
            <div class="pdp-hero__actions">
                <sly data-sly-test="${model.enablePrimaryCta}">
                    <a href="#" class="pdp-hero__download-btn pdf-download" data-sly-test="${model.primaryCtaType=='download'}">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path
                                d="M10.0002 13.3333L5.8335 9.16659L7.00016 7.95825L9.16683 10.1249V3.33325H10.8335V10.1249L13.0002 7.95825L14.1668 9.16659L10.0002 13.3333ZM5.00016 16.6666C4.54183 16.6666 4.14947 16.5034 3.82308 16.177C3.49669 15.8506 3.3335 15.4583 3.3335 14.9999V12.4999H5.00016V14.9999H15.0002V12.4999H16.6668V14.9999C16.6668 15.4583 16.5036 15.8506 16.1772 16.177C15.8509 16.5034 15.4585 16.6666 15.0002 16.6666H5.00016Z"
                                fill="#111213" />
                        </svg>
                        <span>${model.downloadLabel}</span>
                    </a>
                    <!-- Primary CTA (standard link) -->
                    <a data-sly-test="${model.primaryCtaType=='primaryCta'}" href="${model.primaryCtaLink}"
                        class="pdp-hero__download-btn" target="${model.primaryCtaTarget == 'true' ? '_blank' : '_self'}" rel="${model.primaryCtaTarget == 'true' ? 'noopener noreferrer' : ''}">
                        <span>${model.primaryCtaLabel}</span>
                    </a>


                </sly>
                            <!-- Secondary CTA link -->
                <a data-sly-test="${model.enableSecondaryCta}" href="${model.secondaryCtaLink}" target="${model.secondaryCtaTarget == 'true' ? '_blank' : '_self'}" rel="${model.secondaryCtaTarget == 'true' ? 'noopener noreferrer' : ''}" class="pdp-hero__secondary-cta">
                        <span>${model.secondaryCtaLabel}</span>
                </a>
            </div>

        </div>
        <div class="pdp-hero__media">

            <!-- ===================================================== -->
            <!-- IMAGE SECTION (Background / Hero Visual Area) -->
            <!-- ===================================================== -->
            <div class="pdp-hero__image" data-sly-test.image="${model.mediaType=='image'}"
                data-sly-resource="${'image' @ resourceType='ewcmams/components/imageV3'}">
            </div>
            <div class="pdp-hero__video dynamicmedia"
                data-pdp-hero-video-modal="true"
                data-sly-test.video="${model.mediaType=='video'}"
                data-sly-resource="${'dm' @ resourceType='dam/components/scene7/dynamicmedia'}">
            </div>
        </div>
    </div>
</section>





