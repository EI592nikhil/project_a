
function bindDownload(downloadBtn: HTMLAnchorElement | null): void {
    if (!downloadBtn || downloadBtn.dataset.bound === 'true') return;
    downloadBtn.addEventListener('click', (e) => {
        e.preventDefault();
        const hero = downloadBtn.closest('.pdp-hero');
        const heroTitle = hero?.querySelector('.pdp-hero__title')?.textContent?.trim() || "NA";

        adobeDataLayer.push({
            event: adobeDataLayerEvents.component.linkClick,
            linkDetails: {
                clickName:downloadBtn.textContent?.trim().toLowerCase() || "NA",
                clickDestination: "",
                clickLocation: "body",
                clickType: "download",
                clickContext:heroTitle.toLowerCase(),
                componentContext:"product-solution hero"
            }
        });

        window.print();
    });

    downloadBtn.dataset.bound = 'true';
}
// ==========================================
// PRODUCT HERO - CTA CLICK ANALYTICS
// ==========================================

const productHeroComponents = document.querySelectorAll(".pdp-hero");

productHeroComponents.forEach(hero => {

    const heroTitle = hero.querySelector(".pdp-hero__title")?.textContent.trim() || "NA";

    const ctas = hero.querySelectorAll(
        ".pdp-hero__download-btn, .pdp-hero__secondary-cta"
    );

    ctas.forEach(cta => {

        cta.addEventListener("click", function (event) {

            // Prevent duplicate event from global link tracking
            event.stopPropagation();

            const clickName = this.textContent.trim().toLowerCase() || "NA";

            const href = this.getAttribute("href");

            let clickDestination = "";

            if (href && href !== "#") {
                try {
                    clickDestination = new URL(
                        href,
                        window.location.origin
                    ).href;
                } catch (e) {
                    clickDestination = href;
                }
            }


            // Determine click type
            let clickType = "other";

            // Download CTA
            if (this.classList.contains("pdf-download")) {

                clickType = "download";

            } 
            // External URL
            else if (clickDestination) {

                try {

                    const destinationURL = new URL(clickDestination);

                    if (destinationURL.hostname !== window.location.hostname) {
                        clickType = "exit";
                    }

                } catch (e) {
                    clickType = "other";
                }

            }


            adobeDataLayer.push({

                event: adobeDataLayerEvents.component.linkClick,

                linkDetails: {

                    clickName: clickName,

                    clickDestination: clickDestination,

                    clickLocation: "body",

                    clickType: clickType,

                    clickContext: heroTitle.toLowerCase(),

                    componentContext: "product hero"

                }

            });

        });

    });

});
