function initPDPHero(): void {
    const heroBlocks = document.querySelectorAll<HTMLElement>('.pdp-hero');

    if (!heroBlocks.length) return;

    heroBlocks.forEach((hero) => {
        const downloadBtn = hero.querySelector<HTMLAnchorElement>('.pdp-hero__download-btn.pdf-download');
        const videoWrapper = hero.querySelector<HTMLElement>('[data-pdp-hero-video-modal="true"]');

        bindDownload(downloadBtn);
        bindHeroVideoModal(videoWrapper);
    });
}

function bindDownload(downloadBtn: HTMLAnchorElement | null): void {
    if (!downloadBtn || downloadBtn.dataset.bound === 'true') return;

    downloadBtn.addEventListener('click', (e) => {
        e.preventDefault();

        const hero = downloadBtn.closest('.pdp-hero');
        const heroTitle = hero?.querySelector('.pdp-hero__title')?.textContent?.trim() || "NA";
        const adobeDataLayer = (window as any)['adobeDataLayer'];

        if (adobeDataLayer) {
            adobeDataLayer.push({
                event: "linkClick",
                linkDetails: {
                    clickName: downloadBtn.textContent?.trim().toLowerCase() || "NA",
                    clickDestination: "",
                    clickLocation: "body",
                    clickType: "download",
                    clickContext: heroTitle.toLowerCase(),
                    componentContext: "product-solution hero"
                }
            });
        }

        window.print();
    });

    downloadBtn.dataset.bound = 'true';
}


