function convertRawSupTags(root = document.body) {
    const regex = /<sup>(.*?)<\/sup>/gi;

    // Only target elements that actually contain raw <sup> in their text
    // TreeWalker is faster than querySelectorAll for text node traversal
    const walker = document.createTreeWalker(
        root,
        NodeFilter.SHOW_TEXT,
        {
            acceptNode: node =>
                node.nodeValue?.includes('<sup>')
                    ? NodeFilter.FILTER_ACCEPT
                    : NodeFilter.FILTER_REJECT
        }
    );

    const textNodes = [];
    while (walker.nextNode()) textNodes.push(walker.currentNode);

    // Batch all DOM writes after reads — avoid layout thrashing
    textNodes.forEach(textNode => {
        const raw = textNode.nodeValue;
        const fragment = document.createDocumentFragment();
        let lastIndex = 0;
        let match;

        regex.lastIndex = 0; // reset since regex is reused
        while ((match = regex.exec(raw)) !== null) {
            // Text before <sup>
            if (match.index > lastIndex) {
                fragment.appendChild(document.createTextNode(raw.slice(lastIndex, match.index)));
            }

            // Safe sup element — textContent prevents XSS
            const sup = document.createElement('sup');
            sup.textContent = match[1];
            fragment.appendChild(sup);

            lastIndex = regex.lastIndex;
        }

        // Remaining text after last </sup>
        if (lastIndex < raw.length) {
            fragment.appendChild(document.createTextNode(raw.slice(lastIndex)));
        }

        textNode.parentNode.replaceChild(fragment, textNode);
    });
}

function initSuperscript(): void {
    'use strict';

    const NS = 'cmp-superscript';

    const SEL = {
        component: '.' + NS,
        modal: '.' + NS + '__modal',
        footnote: '.' + NS + '__footnote',
        overlay: '.' + NS + '__overlay',
        close: '.' + NS + '__close',
        trigger: '.' + NS + '__trigger'
    };

    interface DataLayerEvent {
        event: string;
        eventInfo: {
            path: string;
            ref: string;
        };
    }

    class SuperscriptComponent {
        el: Element;
        overlay: Element | null;

        constructor(el: Element) {
            this.el = el;
            this.overlay = el.querySelector(SEL.overlay);
            this._scanTriggers();
            this._bindEvents();
        }

        private _scanTriggers(): void {
            document.querySelectorAll('sup').forEach((sup) => {
                const ref = sup.textContent?.trim() || '';
                if (ref) {
                    if (ref.includes('*') || ref.includes('†') || ref.includes('‡')) {
                        sup.textContent = '';
                        sup.appendChild(document.createTextNode('['));
                        const symbol = document.createElement('span');
                        symbol.classList.add('specialSymbol');
                        if (ref.includes('*') || ref.includes('†')) {
                            symbol.classList.add('subbed');
                        }
                        symbol.textContent = ref;
                        sup.appendChild(symbol);
                        sup.appendChild(document.createTextNode(']'));
                    } else {
                        sup.textContent = '[' + ref + ']';
                    }
                    sup.setAttribute('data-ref', ref);
                    sup.setAttribute('role', 'button');
                    sup.setAttribute('tabindex', '0');
                    sup.setAttribute('aria-label', 'See reference ' + ref);
                    sup.classList.add(NS + '__trigger');
                }
            });
        }

        private _bindEvents(): void {
            const self = this;

            document.addEventListener('click', (e) => {
                const target = e.target as Element;
                const trigger = target.closest(SEL.trigger);
                if (trigger) {
                    self._open(trigger.getAttribute('data-ref') || '');
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Enter' || e.key === ' ') {
                    const target = e.target as Element;
                    const trigger = target.closest(SEL.trigger);
                    if (trigger) {
                        e.preventDefault();
                        self._open(trigger.getAttribute('data-ref') || '');
                    }
                }
                if (e.key === 'Escape') {
                    self._closeAll();
                }
            });

            this.el.addEventListener('click', (e) => {
                const target = e.target as Element;
                if (target.closest(SEL.close)) {
                    self._closeAll();
                }
            });

            if (this.overlay) {
                this.overlay.addEventListener('click', () => {
                    self._closeAll();
                });
            }
        }

        private _open(ref: string): void {
            const modal = this.el.querySelector(SEL.modal + '[data-ref="' + ref + '"]');
            const footnote = this.el.querySelector(SEL.footnote + '[data-ref="' + ref + '"]');
            const target = modal || footnote;

            if (!target) {
                return;
            }

            this._closeAll();

            target.setAttribute('aria-hidden', 'false');
            target.classList.add('is-open');
            if (this.overlay) {
                this.overlay.setAttribute('aria-hidden', 'false');
                this.overlay.classList.add('is-active');
            }
            document.body.classList.add(NS + '--body-lock');

            const closeBtn = target.querySelector(SEL.close);
            if (closeBtn) {
                (closeBtn as HTMLElement).focus();
            }

            this._pushDataLayerEvent(ref);
        }

        private _closeAll(): void {
            const self = this;

            [SEL.modal, SEL.footnote].forEach((sel) => {
                self.el.querySelectorAll(sel + '.is-open').forEach((panel) => {
                    panel.setAttribute('aria-hidden', 'true');
                    panel.classList.remove('is-open');
                });
            });

            if (this.overlay) {
                this.overlay.setAttribute('aria-hidden', 'true');
                this.overlay.classList.remove('is-active');
            }
            document.body.classList.remove(NS + '--body-lock');
        }

        private _pushDataLayerEvent(ref: string): void {
            const adobeDataLayer = (window as unknown as { adobeDataLayer?: DataLayerEvent[] }).adobeDataLayer;
            if (adobeDataLayer) {
                adobeDataLayer.push({
                    event: 'cmp:click',
                    eventInfo: {
                        path: 'component.' + this.el.id,
                        ref: ref
                    }
                });
            }
        }
    }

    function onReady(): void {
        document.querySelectorAll(SEL.component).forEach((el) => {
            new SuperscriptComponent(el);
        });
    }

    if (document.readyState !== 'loading') {
        onReady();
    } else {
        document.addEventListener('DOMContentLoaded', onReady);
    }

}

document.addEventListener("DOMContentLoaded", () => {
    const isSuperScriptOnPage = document.querySelectorAll<HTMLElement>(".cmp-superscript");
    if (isSuperScriptOnPage.length > 0) {
        convertRawSupTags()
        initSuperscript();
    }
});
