$bp-sm: 768px;
$bp-lg: 1200px;

@mixin mq-min($min) {
    @media (min-width: $min) {
        @content;
    }
}

.cmp-superscript {
    display: contents;

    &--editor {
        display: block;
    }

    &--body-lock {
        overflow: hidden;
    }

    &__editor-panel {
        border: 1px dashed var(--color-neutral-50);
        border-radius: 6px;
        padding: 12px 16px;
        background: var(--color-neutral-200);
        font-family: var(--Font-Family-Open);
    }

    &__editor-label {
        display: block;
        font-size: var(--Font-Size-Mobile-XS);
        font-weight: var(--Font-Weight-Bold);
        text-transform: uppercase;
        letter-spacing: 0.06em;
        color: var(--color-neutral-500);
        margin-bottom: 10px;
    }

    &__editor-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    &__editor-entry {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: var(--Font-Size-Caption);
    }

    &__editor-title {
        flex: 1;
        color: var(--color-neutral-black);
        font-weight: 600;
    }

    &__editor-type {
        font-size: var(--Font-Size-Mobile-XS);
        color: var(--color-neutral-white);
        background: var(--color-neutral-500);
        border-radius: 3px;
        padding: 1px 6px;
        text-transform: capitalize;
    }

    &__editor-empty {
        margin: 0;
        font-size: var(--Font-Size-Caption);
        color: var(--color-neutral-350);
        font-style: italic;
    }

    &__trigger {
        cursor: pointer;
        color: var(--color-brand-teal-800) !important;
        font: inherit !important;
        vertical-align: middle;
        z-index: 2 !important;

        &:focus-visible {
            outline: 2px solid var(--color-brand-teal-800);
            outline-offset: 2px;
            border-radius: 2px;
        }

        .specialSymbol {
            vertical-align: middle;
        }

        .subbed {
            vertical-align: sub;
        }
    }

    &__overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: 999;
        display: none;

        &.is-active {
            display: block;
        }
    }

    // Modal
    &__modal {
        display: none;
        position: fixed;
        top: 0;
        left: 0;
        transform: translate(0, 0);
        width: 100%;
        height: 100%;
        max-height: 100%;
        background: var(--color-neutral-white);
        z-index: 1000;

        @include mq-min($bp-sm) {
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
            border-radius: 8px;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 548px;
            height: auto;
            max-height: 690px;
        }

        @include mq-min($bp-lg) {
            width: 670px;
            height: auto;
            max-height: 90vh;
        }

        &.is-open {
            display: block;
        }

        .cmp-superscript__badge {
            font-size: 20px;
            font-style: normal;
            color: inherit;
            text-decoration: none;
            font-weight: var(--Font-Weight-Medium);
            line-height: var(--Line-Height-133);
            font-family: var(--Font-Family-Gotham);

            @include mq-min($bp-sm) {
                font-size: 24px;
            }
        }
    }

    &__modal-inner {
        padding: 20px 20px 0 20px;
        height: 100%;

        @include mq-min($bp-sm) {
            padding: 24px 24px 0 24px;
        }

        @include mq-min($bp-lg) {
            padding: 32px 32px 0 32px;
        }

        .cmp-superscript__cta {
            color: var(--color-brand-teal-800);
            text-decoration: underline;
            margin-bottom: 20px;
        }
    }

    &__modal-header {
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 16px;
    }

    &__modal-title {
        color: var(--color-neutral-950);
        font-size: 20px;
        font-family: var(--Font-Family-Gotham);
        font-weight: var(--Font-Weight-Medium);
        margin: 0;
        flex: 1;
        line-height: var(--Line-Height-133);

        @include mq-min($bp-sm) {
            font-size: 24px;
        }
    }

    &__modal-body {
        font-size: 0.875rem;
        line-height: 1.65;
        color: var(--color-neutral-600);
        height: 85vh;
        overflow-y: auto;
        padding-right: 20px;
        font-size: 14px;
        font-family: var(--Font-Family-Open);
        font-weight: 450;
        line-height: var(--Line-Height-175);

        &::-webkit-scrollbar-thumb {
            background-color: var(--color-neutral-450);
            border: 1px solid var(--color-neutral-150);
            border-radius: 40px;
            width: 2px;
        }

        &::-webkit-scrollbar-track {
            background-color: var(--color-neutral-150);
        }

        @include mq-min($bp-sm) {
            height: auto;
            max-height: 578px;
            padding-right: 24px;
        }

        @include mq-min($bp-lg) {
            height: auto;
            max-height: calc(90vh - 150px);
        }

        p {
            margin: 0 0 12px;

            &:last-child {
                margin-bottom: 0;
            }
        }

        p,
        span,
        a {
            font: inherit;
        }
    }

    // Footnote
    &__footnote {
        position: fixed;
        bottom: 24px;
        right: 24px;
        background: var(--color-neutral-white);
        border-radius: 8px;
        box-shadow: 0 4px 24px rgba(0, 0, 0, 0.18);
        width: 90%;
        max-width: 380px;
        z-index: 1000;
        padding: 20px;
        display: none;
        flex-direction: row;
        align-items: flex-start;
        gap: 12px;

        &.is-open {
            display: flex;
        }

        @include mq-min($bp-sm) {
            gap: 20px;
            max-width: 728px;
        }

        @include mq-min($bp-lg) {
            gap: 20px;
            max-width: 670px;
        }
    }

    &__footnote-content {
        flex: 1;
        min-width: 0;
    }

    &__footnote-title {
        display: block;
        font-size: var(--Font-Size-Mobile-LG);
        font-weight: var(--Font-Weight-Bold);
        line-height: 29.88px;
        font-family: var(--Font-Family-Open);
        margin-bottom: 8px;
        color: var(--color-neutral-950);

    }

    &__footnote-body {
        font-size: var(--Font-Size-Caption);
        line-height: var(--Line-Height-150);

        p {
            margin: 0 0 8px;
            font-family: var(--Font-Family-Open);
            font-weight: 450;
            font-size: 14px;
            line-height: 24.5px;
            color: var(--color-neutral-600);

            &:last-child {
                margin-bottom: 0;
            }
        }

        a {
            color: var(--color-brand-teal-800);
            text-decoration: underline;
        }
    }

    // Shared
    &__badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--color-brand-teal-800);
        font-family: var(--Font-Family-Open);
        font-size: 16px;
        line-height: 26.56px;
        font-weight: var(--Font-Weight-Book);
        padding: 3px 0;
        flex-shrink: 0;
        letter-spacing: 0.01em;
        text-decoration: underline;
        text-decoration-style: solid;
        text-decoration-thickness: 0.78%;
        text-underline-position: from-font;
    }

    &__close {
        background: none;
        border: none;
        cursor: pointer;
        font-size: 1.125rem;
        line-height: 1;
        padding: 4px;
        flex-shrink: 0;
        margin-left: auto;
        display: flex;
        align-items: center;
        justify-content: center;

        &:focus-visible {
            outline: 2px solid var(--color-brand-teal-800);
            border-radius: 2px;
        }
    }

    &__cta {
        display: inline-block;
        margin-top: 8px;
        color: var(--color-brand-teal-800) !important;
        font: normal 450 var(--Font-Size-Mobile-XS)/var(--Line-Height-175) var(--Font-Family-Open) !important;
        text-decoration: underline !important;
        text-decoration-style: solid !important;
        text-decoration-thickness: 6% !important;
        text-underline-offset: 8% !important;
        text-underline-position: from-font !important;

        @include mq-min($bp-sm) {
            font-size: var(--Font-Size-Tablet-XS) !important;
            margin-top: 4px;
        }

    }
}

h1,
h2,
h3,
h4,
h5,
h6 {
    .cmp-superscript__trigger {
        vertical-align: sub;

        .subbed {
            vertical-align: sub;
        }
    }
}
