<sly data-sly-use.model="com.centurylink.aem.core.models.SuperscriptModel"
    data-sly-use.templates="core/wcm/components/commons/v1/templates.html"
    data-sly-use.clientlib="/libs/granite/sightly/templates/clientlib.html" />

<sly data-sly-call="${clientlib.all @ categories='ewcmams.components.superscript'}" />

<div data-sly-test="${!wcmmode.disabled || model.hasItems}" id="${model.id}"
    class="cmp-superscript${!wcmmode.disabled ? ' cmp-superscript--editor' : ''}"
    data-cmp-data-layer="${model.dataLayerJson}">

    <!-- Author-mode preview panel -->
    <sly data-sly-test="${!wcmmode.disabled}">
        <div class="cmp-superscript__editor-panel">
            <span class="cmp-superscript__editor-label">Tooltip Superscript</span>
            <sly data-sly-test="${model.hasItems}">
                <ul class="cmp-superscript__editor-list">
                    <sly data-sly-list.item="${model.items}">
                        <li class="cmp-superscript__editor-entry">
                            <span class="cmp-superscript__badge">[${item.refNumber}]</span>
                            <span class="cmp-superscript__editor-title">${item.title}</span>
                            <span class="cmp-superscript__editor-type">${item.displayType}</span>
                        </li>
                    </sly>
                </ul>
            </sly>
            <p data-sly-test="${!model.hasItems}" class="cmp-superscript__editor-empty">No superscript entries
                configured.</p>
        </div>
    </sly>

    <div class="cmp-superscript__overlay" aria-hidden="true"></div>

    <sly data-sly-list.item="${model.items}">

        <sly data-sly-test="${item.displayType == 'modal'}">
            <div class="cmp-superscript__modal" data-ref="${item.refNumber}" aria-hidden="true" role="dialog"
                aria-modal="true" aria-labelledby="superscript-title-${item.refNumber @ context='attribute'}">
                <div class="cmp-superscript__modal-inner">
                    <div class="cmp-superscript__modal-header">
                        <span class="cmp-superscript__badge">${item.refNumber}:</span>
                        <div id="superscript-title-${item.refNumber @ context='attribute'}"
                            class="cmp-superscript__modal-title">${item.title}</div>
                        <button class="cmp-superscript__close" type="button" aria-label="Close dialog">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16"
                                fill="none">
                                <path
                                    d="M8 9.70342L2.03802 15.6654C1.81496 15.8885 1.53105 16 1.18631 16C0.841571 16 0.557667 15.8885 0.3346 15.6654C0.111533 15.4423 0 15.1584 0 14.8137C0 14.4689 0.111533 14.185 0.3346 13.962L6.29658 8L0.3346 2.03802C0.111533 1.81496 0 1.53105 0 1.18631C0 0.841571 0.111533 0.557667 0.3346 0.3346C0.557667 0.111533 0.841571 0 1.18631 0C1.53105 0 1.81496 0.111533 2.03802 0.3346L8 6.29658L13.962 0.3346C14.185 0.111533 14.4689 0 14.8137 0C15.1584 0 15.4423 0.111533 15.6654 0.3346C15.8885 0.557667 16 0.841571 16 1.18631C16 1.53105 15.8885 1.81496 15.6654 2.03802L9.70342 8L15.6654 13.962C15.8885 14.185 16 14.4689 16 14.8137C16 15.1584 15.8885 15.4423 15.6654 15.6654C15.4423 15.8885 15.1584 16 14.8137 16C14.4689 16 14.185 15.8885 13.962 15.6654L8 9.70342Z"
                                    fill="#686C73" />
                            </svg>
                        </button>
                    </div>
                    <div class="cmp-superscript__modal-body">${item.body @ context='html'}</div>
                    <sly data-sly-test="${item.ctaText && item.ctaUrl}">
                        <a class="cmp-superscript__cta" href="${item.ctaUrl @ extension='html'}">${item.ctaText}</a>
                    </sly>
                </div>
            </div>
        </sly>

        <sly data-sly-test="${item.displayType == 'footnote'}">
            <div class="cmp-superscript__footnote" data-ref="${item.refNumber}" aria-hidden="true" role="complementary">
                <span class="cmp-superscript__badge">[${item.refNumber}]</span>
                <div class="cmp-superscript__footnote-content">
                    <strong class="cmp-superscript__footnote-title">${item.title}</strong>
                    <div class="cmp-superscript__footnote-body">${item.body @ context='html'}</div>
                    <sly data-sly-test="${item.ctaText && item.ctaUrl}">
                        <a class="cmp-superscript__cta" href="${item.ctaUrl @ extension='html'}">${item.ctaText}</a>
                    </sly>
                </div>
                <button class="cmp-superscript__close" type="button" aria-label="Close">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 16 16" fill="none">
                        <path
                            d="M8 9.70342L2.03802 15.6654C1.81496 15.8885 1.53105 16 1.18631 16C0.841571 16 0.557667 15.8885 0.3346 15.6654C0.111533 15.4423 0 15.1584 0 14.8137C0 14.4689 0.111533 14.185 0.3346 13.962L6.29658 8L0.3346 2.03802C0.111533 1.81496 0 1.53105 0 1.18631C0 0.841571 0.111533 0.557667 0.3346 0.3346C0.557667 0.111533 0.841571 0 1.18631 0C1.53105 0 1.81496 0.111533 2.03802 0.3346L8 6.29658L13.962 0.3346C14.185 0.111533 14.4689 0 14.8137 0C15.1584 0 15.4423 0.111533 15.6654 0.3346C15.8885 0.557667 16 0.841571 16 1.18631C16 1.53105 15.8885 1.81496 15.6654 2.03802L9.70342 8L15.6654 13.962C15.8885 14.185 16 14.4689 16 14.8137C16 15.1584 15.8885 15.4423 15.6654 15.6654C15.4423 15.8885 15.1584 16 14.8137 16C14.4689 16 14.185 15.8885 13.962 15.6654L8 9.70342Z"
                            fill="#686C73" />
                    </svg>

                </button>
            </div>
        </sly>

    </sly>

</div>

<sly data-sly-call="${templates.placeholder @ isEmpty=!model.hasItems, classAppend='cmp-superscript'}"></sly>
