/* =====================================
   SDP PDP TEXT CONTAINER
===================================== */
.sdppdptextcontainer {
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  width: 100%;
  min-height: 548px;
  padding:
    72px
    var(--Spacing-4xl);
  background: var(--surface-neutral-strong-light);

  /* =====================================
     CONTENT WRAPPER
  ===================================== */
  .content-wrapper {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  /* =====================================
     TITLE
  ===================================== */
  .title {
    margin: 0;
    color: var(--text-headline-light);
    font-family: var(--Font-Family-Gotham);
    font-size: var(--Font-Size-H4);
    font-style: normal;
    font-weight: var(--Font-Weight-Book);
    line-height: var(--Line-Height-125);
  }

  /* =====================================
     DESCRIPTION
  ===================================== */
  .description_one,
  .description_two {
    width: 100%;
    color: var(--text-subtle-light);
    font-family: var(--Font-Family-Open);
    font-size: var(--Font-Size-Desktop-LG);
    font-style: normal;
    font-weight: var(--Font-Weight-Regular);
    line-height: var(--Line-Height-166);
    p {
      margin: 0;
    width: 100%;
    color: var(--text-subtle-light);
    font-family: var(--Font-Family-Open) !important;
    font-size: var(--Font-Size-Desktop-LG);
    font-style: normal;
    font-weight: var(--Font-Weight-Regular);
    line-height: var(--Line-Height-166);
    }
  }
  /* =====================================
     CTA WRAPPER
  ===================================== */
  .cta-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  /* =====================================
     PRIMARY CTA
  ===================================== */
  .primary_cta {
    display: flex;
    justify-content: center;
    align-items: center;
    padding:
      14px
      var(--Spacing-3xl);
    border-radius: 8px;
    background:var(
    --Red-Orange-Gradient,
    linear-gradient(
      90deg,
      var(--Color-Brand-Red-400, #FA6E5C) 0%,
      var(--Color-Brand-Orange-500, #FB862D) 100%
    )
  );
    color: var(--text-button-primary-light);
    text-decoration: none;
    font-family: var(--Font-Family-Gotham);
    font-size: var(--Font-Size-Desktop-MD);
    font-style: normal;
    font-weight: var(--Font-Weight-Medium);
    line-height: var(--Line-Height-125);
    transition: 0.3s ease;
  }

  /* =====================================
     SECONDARY CTA
  ===================================== */
  .secondary_cta {
    display: flex;
    justify-content: center;
    align-items: center;
    padding:
      14px
      var(--Spacing-3xl);
    border-radius: 8px;
    border:
      2px
      solid
      var(--color-brand-orange-500);
    background: transparent;
    color: var(--text-headline-light);
    text-decoration: none;
    font-family: var(--Font-Family-Gotham);
    font-size: var(--Font-Size-Desktop-MD);
    font-style: normal;
    font-weight: var(--Font-Weight-Medium);
    line-height: var(--Line-Height-125);
    transition: 0.3s ease;
  }

  /* =====================================
     SINGLE COLUMN LEFT
  ===================================== */
  &.singlecolumn_left,
  &:not(.doublecolumn):not(.singlecolumn_right) {

    .content-wrapper {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 100%;
      max-width: 900px;
      gap: 32px;
    }

    .cta-wrapper {
      justify-content: flex-start;
    }
  }

  /* =====================================
     SINGLE COLUMN RIGHT
  ===================================== */
  &.singlecolumn_right {
    justify-content: flex-end;

    .content-wrapper {
      display: flex;
      flex-direction: column;
      width: 100%;
      max-width: 900px;
      margin-left: auto;
      gap: 32px;
    }

    .title,
    .description_one,
    .description_two,
    .cta-wrapper {
      width: 100%;
    }

    .title,
    .description_one,
    .description_two {
      text-align: left;
    }

    .description_one p,
    .description_two p {
      text-align: left;
      margin: 0;
    }

    .cta-wrapper {
      justify-content: flex-start;
    }
  }

  /* =====================================
     DOUBLE COLUMN
  ===================================== */
  &.doublecolumn {

    .content-wrapper {
      display: grid;
      grid-template-areas:
        "title title"
        "desc1 desc2"
        "cta cta";
      grid-template-columns:
        minmax(0, 1fr)
        minmax(0, 1fr);
      column-gap: 20px;
      row-gap: 32px;
      width: 100%;
    }

    .title {
      grid-area: title;
    }

    .description_one {
      grid-area: desc1;
    }

    .description_two {
      grid-area: desc2;
    }

    .cta-wrapper {
      grid-area: cta;
      justify-content: end;
    }
  }

  /* =====================================
     BLOB DEFAULT
  ===================================== */
  &::after {
    display: none;
  }

  /* =====================================
     WITH BLOB
  ===================================== */
  &.with_blob {

    &::after {
      content: "";

      position: absolute;
      display: block;
      background:
        linear-gradient(
          270deg,
          var(--color-brand-yellowbright-500) 0%,
          var(--color-brand-orange-500) 100%
        );

      background-blend-mode: plus-darker;
      transform: rotate(90deg);
      z-index: 1;
    }

    /* =====================================
       SINGLE LEFT BLOB
    ===================================== */

    &.singlecolumn_left {

      &::after {
        width: 280px;
        height: 100px;
        border-radius:
          82px
          82px
          82px
          0;
        top: -60px;
        right: 40px;
      }
    }

    /* =====================================
       SINGLE RIGHT BLOB
    ===================================== */

    &.singlecolumn_right {

      &::after {
        width: 280px;
        height: 100px;
        border-radius:
          82px
          82px
          82px
          0;
        top: -60px;
        left: 40px;
      }
    }

    /* =====================================
       DOUBLE COLUMN BLOB
    ===================================== */
    &.doublecolumn {

      &::after {
        width: 272px;
        height: 100px;
        border-radius:
          80px
          80px
          80px
          0;
        top: -80px;
        right: 40px;
      }
    }
  }
}

/* =====================================
   TABLET
===================================== */
@media screen and (max-width: 1024px) {

  .sdppdptextcontainer {
    min-height: auto;
    padding:64px 20px;

    .title {
      font-size: var(--Font-Size-Tablet-H4);
    }

    .description_one,
    .description_two {
      font-size: var(--Font-Size-Tablet-MD);
    }

    &.singlecolumn_right {

      .content-wrapper {
        align-items: flex-start;
        margin-left: 0;
      }
    }

    &.doublecolumn {
      .content-wrapper {
        grid-template-columns: 1fr;
        grid-template-areas:
          "title"
          "desc1"
          "desc2"
          "cta";
      }
    }

    &.with_blob {

      &::after {
        width: 200px !important;
        height: 80px !important;
        border-radius:
          58.824px
          58.824px
          58.824px
          0 !important;
        top: -50px !important;
        right: 32px !important;
        left: auto !important;
      }
    }
  }
}

/* =====================================
   MOBILE
===================================== */

@media screen and (max-width: 767px) {

  .sdppdptextcontainer {
    min-height: auto;
    padding:48px 20px;
    .content-wrapper {
      gap: 24px !important;
    }

    .title {
      font-size: var(--Font-Size-Mobile-H4);
    }

    .description_one,
    .description_two {
      font-size: var(--Font-Size-Mobile-SM);
    }

    .cta-wrapper {
      width: 100%;
      flex-direction: column;
    }

    .primary_cta,
    .secondary_cta {
      width: 100%;
    }

    &.singlecolumn_right {

      .content-wrapper {
        margin-left: 0;
        align-items: flex-start;
      }
    }

    &.with_blob {

      &::after {
        width: 135.593px !important;
        height: 60px !important;
        border-radius:
          39.88px
          39.88px
          39.88px
          0 !important;
        top:-60px !important;
        right:-10px !important;
        left: auto !important;
      }
    }
  }
}
