package com.centurylink.aem.core.models;

import com.centurylink.aem.core.models.constants.CtlConstants;
import com.centurylink.aem.core.models.utils.ProductSolutionPagePropertyUtil;
import com.centurylink.aem.core.services.ContentFragmentDataService;
import com.centurylink.aem.core.utils.DataLayerUtil;
import com.day.cq.wcm.api.Page;
import com.day.cq.wcm.api.PageManager;
import com.drew.lang.annotations.Nullable;
import com.fasterxml.jackson.core.JsonProcessingException;
import com.fasterxml.jackson.databind.ObjectMapper;
import org.apache.commons.lang3.StringUtils;
import org.apache.sling.api.SlingHttpServletRequest;
import org.apache.sling.api.resource.Resource;
import org.apache.sling.api.resource.ResourceResolver;
import org.apache.sling.models.annotations.DefaultInjectionStrategy;
import org.apache.sling.models.annotations.Model;
import org.apache.sling.models.annotations.injectorspecific.ChildResource;
import org.apache.sling.models.annotations.injectorspecific.OSGiService;
import org.apache.sling.models.annotations.injectorspecific.SlingObject;
import org.apache.sling.models.annotations.injectorspecific.ValueMapValue;
import org.slf4j.Logger;
import org.slf4j.LoggerFactory;

import javax.annotation.PostConstruct;
import java.util.*;

@Model(
        adaptables = {SlingHttpServletRequest.class, Resource.class},
        defaultInjectionStrategy = DefaultInjectionStrategy.OPTIONAL
)
public class SubHeaderStickyNavModel {

    public static final String RESOURCE_TYPE = "ewcmams/components/subheadernav";

    private String id;

    private boolean dataLayerEnabled;

    @ValueMapValue
    private String linkText;

    @ValueMapValue
    private String showLink1;
    
    @ValueMapValue
    private String showLink2;

    @ValueMapValue
    private String linkUrl;

    @ValueMapValue
    private String linkTarget;

    @ValueMapValue
    private String secondLinkText;

    @ValueMapValue
    private String secondLinkUrl;

    @ValueMapValue
    private String secondLinkTarget;

    @ValueMapValue
    private String ootbBreadcrumb;

    @ChildResource(name = "navTitle")
    private List<NavigationTitle> navTitle;

    @SlingObject
    private ResourceResolver resolver;

    @SlingObject
    private Resource resource;

    @OSGiService
    private ContentFragmentDataService cfService;

    private String productTitle;

    private String solutionTitle;

    private String parentPageTitle;

    private String parentPageUrl;

    private static final Logger LOGGER = LoggerFactory.getLogger(SubHeaderStickyNavModel.class);

    @PostConstruct
    protected void init() {
        id = DataLayerUtil.generateId("SubHeader-Navigation", resource.getPath());
        dataLayerEnabled = StringUtils.isNotBlank(id);

        LOGGER.info("Initialized component id :: {}", id);

        PageManager pageManager = resource.getResourceResolver().adaptTo(PageManager.class);
        if (pageManager != null) {
            Page currentPage = pageManager.getContainingPage(resource);
            if (currentPage != null) {
                parentPageTitle = ProductSolutionPagePropertyUtil.getParentTitle(currentPage);
                parentPageUrl = ProductSolutionPagePropertyUtil.getParentPath(currentPage);
                productTitle = ProductSolutionPagePropertyUtil.getCfTitleField(currentPage, "productCfPath", resolver, cfService);
                solutionTitle = ProductSolutionPagePropertyUtil.getCfTitleField(currentPage, "solutionContentFragment", resolver, cfService);

            }
        }

    }

    public String getProductTitle() {
        return productTitle;
    }

    public String getSolutionTitle() {
        return solutionTitle;
    }

    public List<NavigationTitle> getNavTitle() {
        return navTitle == null ? Collections.emptyList() : Collections.unmodifiableList(navTitle);
    }

    public String getLinkText() {
        return linkText;
    }
    
    public String getLinkUrl() {

        if (linkUrl == null) {
            return null;
        }

        if (linkUrl.startsWith("http://") ||
            linkUrl.startsWith("https://")) {
            return linkUrl;
        }

        if (linkUrl.contains("#")) {
            return linkUrl;
        }

        if (linkUrl.endsWith(CtlConstants.HTML_EXTENSION)) {
            return linkUrl;
        }

        return linkUrl + CtlConstants.HTML_EXTENSION;
    }


    public String getLinkTarget() {
        return linkTarget;
    }

    public boolean isShowLink1() {
    return Boolean.TRUE.equals(showLink1);
    }

    public boolean isShowLink2() {
        return Boolean.TRUE.equals(showLink2);
    }

    public String getSecondLinkText() {
        return secondLinkText;
    }

    public String getSecondLinkUrl() {

        if (secondLinkUrl == null) {
            return null;
        }

        if (secondLinkUrl.startsWith("http://") ||
            secondLinkUrl.startsWith("https://")) {
            return secondLinkUrl;
        }

        if (secondLinkUrl.contains("#")) {
            return secondLinkUrl;
        }

        if (secondLinkUrl.endsWith(CtlConstants.HTML_EXTENSION)) {
            return secondLinkUrl;
        }

        return secondLinkUrl + CtlConstants.HTML_EXTENSION;
    }

    public String getSecondLinkTarget() {
        return secondLinkTarget;
    }

    @Nullable
    public String getId() {
        return id;
    }

    public boolean isDataLayerEnabled() {
        return dataLayerEnabled;
    }

    public String getData() {
        if (!dataLayerEnabled || navTitle.isEmpty()) {
            return null;
        }
        Map<String, Object> data = new HashMap<>();
        data.put("componentName", "SubHeader-Navigation");
        data.put("resourceType", RESOURCE_TYPE);
        data.put("navTitle", navTitle);
        data.put("linkText", linkText);
        data.put("linkUrl", linkUrl);
        data.put("secondLinkText", secondLinkText);
        data.put("secondLinkUrl", secondLinkUrl);
        data.put("id", id);
        if (StringUtils.isBlank(id)) {
            return null;
        }
        try {
            return String.format("{\"%s\":%s}",
                    id,
                    new ObjectMapper().writeValueAsString(data));
        } catch (JsonProcessingException e) {
            LOGGER.error("Unable to generate dataLayer JSON string for Subheader Navigation component", e);
        }
        return null;
    }

    public String getParentPageTitle() {
        return parentPageTitle;
    }

    public String getParentPageUrl(){
        return parentPageUrl;
    }

    public String getOotbBreadcrumb() {
        return ootbBreadcrumb;
    }

    @Model(adaptables = Resource.class, defaultInjectionStrategy = DefaultInjectionStrategy.OPTIONAL)
    public static class NavigationTitle {

        @ValueMapValue
        private String title;

        public String getTitle() {
            return title;
        }
    }

}


