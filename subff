$arrow-svg-cds: "data:image/svg+xml;base64,";

.statistictile {
    max-width: 100%;
}

.statistictile.article-cards-stats {
    display: flex;
    flex-direction: column;
    background: var(--surface-neutral-strong-light);
    width: 100%;
    max-width: 100%;
    padding: 48px 20px;

    .instanceplaceholder.gridColoumn6 & {
            padding: 0 !important;
        }

    @media (min-width: 768px) {
        max-width: 100%;
        padding: 64px 20px;

        .instanceplaceholder.gridColoumn6 & {
            padding: 0 !important;
        }
    }

    @media (min-width: 1200px) {
        max-width: 100%;
        padding: 72px 40px;

        .instanceplaceholder.gridColoumn6 & {
            padding: 0 !important;
        }
    }
    @media (min-width: 1200px) {
  .cards.wrapper .statistictile__card:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    width: calc((100% - var(--spacing-lg)) / 2) !important;
    justify-self: start;
  }
}

    // =========================
    // GRID LAYOUT
    // =========================
    .cards.wrapper {
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-4xl) var(--spacing-lg);

        // Tablet
        @media (min-width: 768px) {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-5xl) var(--spacing-lg);
        }

        // Desktop (IMPORTANT: keep 2 cols)
        @media (min-width: 1200px) {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-5xl) var(--spacing-lg);
        }
    }

    // =========================
    // CARD LAYOUT FIX
    // =========================
    .statistictile__card {
        display: flex;
        flex-direction: column;
        justify-content: flex-start; 
        gap: var(--spacing-md);      
        height: 100%;                
    }

    // =========================
    // STAT
    // =========================
    .statistictile__stat {
        color: var(--text-headline-light);
        font-family: var(--Font-Family-Gotham) !important;
        font-size: var(--Font-Size-Mobile-H2);
        font-weight: var(--Font-Weight-Book);
        line-height: var(--Line-Height-112);
        letter-spacing: -1.6px;
        border-bottom: 1px solid var(--color-neutral-200);
        padding-bottom: var(--spacing-xl);
        margin: 0;

        @media (min-width: 768px) {
            font-size: var(--Font-Size-Tablet-H2);
        }

        @media (min-width: 1024px) {
            font-size: var(--Font-Size-H2);
        }
    }

    // =========================
    // TITLE (FIXED VISIBILITY)
    // =========================
    .statistictile__title {
        display: block;              
        visibility: visible;         
        padding-top: var(--spacing-sm);
        margin: 0;

        color: var(--text-headline-light);
        font-family: var(--Font-Family-Gotham) !important;
        font-size: var(--Font-Size-Mobile-H6);
        font-weight: var(--Font-Weight-Medium);
        line-height: var(--Line-Height-133);

        @media (min-width: 768px) {
            font-size: var(--Font-Size-Tablet-H6);
        }

        @media (min-width: 1024px) {
            font-size: var(--Font-Size-H6);
        }
    }

    // =========================
    // TEXT (REMOVE FLEX STRETCH)
    // =========================
 
    .statistictile__text {
    flex: unset;

    p {
        margin: 0;
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
        overflow: hidden;
        text-overflow: ellipsis;
        color: var(--Text-Subtle);
        font-family: var(--Font-Family-Open) !important;
        font-size: var(--Font-Size-Desktop-LG);
        font-weight: var(--Font-Weight-Regular);
        line-height: var(--Line-Height-166);

        align-self: stretch;
    }
}

    // =========================
    // CTA FIX (NO AUTO PUSH)
    // =========================
    .statistictile__cta-container {
        margin-top:auto; 
    }

 .statistictile__cta {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    color: var(--text-strong-light);
    font-family: var(--Font-Family-Gotham) !important;
    font-size: var(--Font-Size-Small);
    font-weight: var(--Font-Weight-Medium);
    line-height: var(--Line-Height-125);

    &::after {
        content: "";
        width: 20px;
        height: 20px;
        flex-shrink: 0; 
        display: inline-block;
        background-image: url(unquote($arrow-svg-cds)); 
        background-size: contain;
        background-repeat: no-repeat;
        background-position: center;

        transition: transform 0.2s ease; 
    }

    &:hover {
        opacity: 0.85;
        text-decoration: underline;
    }

        &:hover::after {
            transform: translateX(3px);
        }

        &.cmp-teaser__action-link:focus-visible {
            outline: 2px solid var(--color-brand-blue-700) !important;
        }
    }
}

// ================================================================
// COMPACT VARIANT 
// ================================================================
.statistictile--compact {

    // =========================
    // OUTER CONTAINER (FIXED)
    // =========================
    display: flex;
    flex-direction: column;
    background: var(--surface-neutral-strong-light);
    width: 100%;
    max-width: 360px;
    padding: var(--spacing-2xl) var(--spacing-lg);
    align-items: flex-start;

    @media only screen and (min-width: 768px) {
        max-width: 768px;
        padding: var(--spacing-3xl) var(--spacing-lg);
    }

    @media only screen and (min-width: 1200px) {
        max-width: 1440px;
        align-items: center;
        padding: var(--spacing-4xl);
    }
}
    // =========================
    // INNER CARD CONTAINER
    // =========================
    .statistictile__compact-container {
        width: 100%;
        border: 1px solid var(--color-neutral-200);
        border-radius: var(--radius-60);
        padding: var(--spacing-xl) var(--spacing-2xl);

        @media only screen and (min-width: 768px) {
            padding: var(--spacing-3xl);
        }
        @media only screen and (min-width: 1200px) {
            padding: var(--spacing-5xl);
        }

    }

    // =========================
    // TITLE (H5 BOOK)
    // =========================
    .statistictile__component-title {
        align-self: stretch;
        color: var(--text-headline-light);
        font-feature-settings: 'case' on;
        font-family: var(--Font-Family-Title, Gotham) !important;
        font-style: normal;
        font-weight: 400;
        line-height: 133%;

        // MOBILE
        font-size: var(--Font-Size-Mobile-H5) !important;
        margin: 0 0 var(--spacing-2xl) 0 !important;

        // TABLET
        @media only screen and (min-width: 768px) {
            font-size: var(--Font-Size-Tablet-H5) !important;
            margin-bottom: var(--spacing-4xl) !important;
        }

        // DESKTOP
        @media only screen and (min-width: 1200px) {
            font-size: var(--Font-Size-H5) !important;
             margin-bottom: var(--spacing-4xl) !important;
        }
    }

    // =========================
    // GRID WRAPPER
    // =========================
    .statistictile__compact-grid {
        display: flex;
        flex-direction: column;
    }

    // =========================
    // ROW (WITH DIVIDER)
    // =========================
    .statistictile__compact-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: var(--spacing-lg);
        padding: var(--spacing-xl) 0;
        align-items: stretch;

        // MOBILE STACK
        @media only screen and (max-width: 767px) {
            grid-template-columns: 1fr;
            gap: var(--spacing-md);
            padding:0px;
        }

        // REMOVE LAST BORDER
        &:last-child {
            border-bottom: none;
        }
    }

    // =========================
    // CELL
    // =========================
    .statistictile__compact-cell {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-2xl);
    height: 100%;
    justify-content: space-between;

    @media only screen and (min-width: 768px) {
        gap: var(--spacing-4xl);
    }

    // =========================
    // STAT VALUE (H5 MEDIUM)
    // =========================
    .statistictile__stat {
        flex: 1 0 0;
        color: var(--text-headline-light);
        font-feature-settings: 'case' on;
        font-family: var(--Font-Family-Title, Gotham) !important;
        font-style: normal;
        font-weight: 500;
        line-height: 133%;
        border-bottom: 1px solid var(--color-neutral-200);
        display: flex;
        align-items: flex-end;
        gap:var(--spacing-xs);
        padding-bottom: var(--spacing-md);
        align-self: stretch;

        // MOBILE
        font-size: var(--Font-Size-Mobile-H5);

        // TABLET
        @media only screen and (min-width: 768px) {
            font-size: var(--Font-Size-Tablet-H5);
        }

        // DESKTOP
        @media only screen and (min-width: 1200px) {
            font-size: var(--Font-Size-H5);
        }
    }

    // =========================
    // LABEL
    // =========================
    .statistictile__compact-label {
        p {
            margin: 0;
            color: var(--Text-Subtle);
            font-family: var(--Font-Family-Open) !important;
            font-size: var(--Font-Size-Body);
            font-weight: var(--Font-Weight-Regular);
            line-height: var(--Line-Height-166);
        }
    }
}

/* =====================================
   STATISTIC TITLE - COL 6 & 8
===================================== */

.instanceplaceholder.gridColoumn6 .statistictile--compact,
.instanceplaceholder.gridColoumn8 .statistictile--compact {
  padding: var(--spacing-4xl) 0;
}

/* Desktop */
.instanceplaceholder.gridColoumn6 .statistictitle__component-title,
.instanceplaceholder.gridColoumn8 .statistictitle__component-title {
  font-size: 36px;
}

/* Tablet */
@media (max-width: 1024px) {
  .instanceplaceholder.gridColoumn6 .statistictitle__component-title,
  .instanceplaceholder.gridColoumn8 .statistictitle__component-title {
    font-size: 32px;
  }
}

/* Mobile */
@media (max-width: 767px) {
  .instanceplaceholder.gridColoumn6 .statistictitle__component-title,
  .instanceplaceholder.gridColoumn8 .statistictitle__component-title {
    font-size: 24px;
  }
}
