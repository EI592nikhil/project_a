<div data-sly-test="${wcmmode.edit}"
     class="cq-placeholder"
     data-emptytext="Edit ${component.title}">
</div>

<sly data-sly-use.model="com.centurylink.aem.core.models.SubHeaderStickyNavModel">

<div class="subheader-wrapper">
    <!-- =========================================
         BREADCRUMB (NON STICKY)
    ========================================== -->

    <div class="breadcrumb">

        <sly data-sly-resource="${'breadcrumb' @ resourceType='core/wcm/components/breadcrumb/v2/breadcrumb'}"/>

    </div>

    <!-- =========================================
         STICKY SUB NAV
    ========================================== -->

    <div class="pdp-subheadernav">

        <div class="subheadernav-wrapper"
             data-cmp-data-layer='${model.data}'>

            <!-- =========================================
                 DESKTOP NAV
            ========================================== -->

            <div class="subheadernav-items">

                <sly data-sly-list.titleList="${model.navTitle}">

                    <span
                        class="subheadernav-item ${titleListList.index == 0 ? 'active' : ''}"
                        data-target="${titleList.title}">

                        ${titleList.title}

                    </span>

                </sly>

            </div>

            <!-- =========================================
                 MOBILE/TABLET DROPDOWN
            ========================================== -->

            <div class="subheadernav-mobile-dropdown">

                <!-- Trigger -->

                <button class="subheadernav-dropdown-trigger">

                    <sly data-sly-list.titleList="${model.navTitle}">

                        <sly data-sly-test="${titleListList.index == 0}">

                            ${titleList.title}

                        </sly>

                    </sly>

                </button>

                <!-- Dropdown Menu -->

                <div class="subheadernav-dropdown-menu">

                    <sly data-sly-list.titleList="${model.navTitle}">

                        <sly data-sly-test="${titleListList.index != 0}">

                            <span
                                class="subheadernav-item"
                                data-target="${titleList.title}">

                                ${titleList.title}

                            </span>

                        </sly>

                    </sly>

                </div>

            </div>

            <!-- =========================================
                 CTA LINKS
            ========================================== -->

            <div class="subheadernav-links">

                <a class="subheadernav-link secondary"
                   href="${model.linkUrl}">

                    ${model.linkText}

                </a>

                <a class="subheadernav-link primary"
                   href="${model.secondLinkUrl}">

                    ${model.secondLinkText}

                </a>

            </div>

        </div>

    </div>
</div>
</sly>




