.breadcrumb {

  .cmp-breadcrumb__list {
    display: flex;
    align-items: center;
    gap: 8px;
    list-style: none;
    padding: 0;
    margin: 0;
    flex-wrap: wrap;
  }

  /* =====================================
     Breadcrumb Typography
  ===================================== */
  .cmp-breadcrumb__item,
  .cmp-breadcrumb__item-link,
  .cmp-breadcrumb__item span,
  .cmp-breadcrumb__item-link span,
  .cmp-breadcrumb__item--active span {

    font-feature-settings: 'case' on;
    color: var(--text-default-light);
    font-family: var(--Font-Family-Gotham);
	  font-size: var(--Font-Size-Desktop-SM);
    font-style: var(--Font-Style-Normal);
    font-weight: var(--Font-Weight-Regular);
    line-height: 125%;

    text-decoration: none;
  }

  /* =====================================
     Remove Hover / Focus / Visited Styles
  ===================================== */
  .cmp-breadcrumb__item-link,
  .cmp-breadcrumb__item-link span {
    text-decoration: none;
  }

  .cmp-breadcrumb__item-link:hover,
  .cmp-breadcrumb__item-link:hover span,

  .cmp-breadcrumb__item-link:focus,
  .cmp-breadcrumb__item-link:focus span,

  .cmp-breadcrumb__item-link:active,
  .cmp-breadcrumb__item-link:active span,

  .cmp-breadcrumb__item-link:visited,
  .cmp-breadcrumb__item-link:visited span {

    color: var(--text-default-light);
    text-decoration: none;
    border-bottom: none;
    box-shadow: none;
  }

  /* =====================================
     Remove Core Component Separator
  ===================================== */
  .cmp-breadcrumb__item::before {
    content: none;
  }

  /* =====================================
     Custom "/" Separator
  ===================================== */
  .cmp-breadcrumb__list .cmp-breadcrumb__item:not(:first-child)::before {
    content: "/";
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8px;
    height: 18px;
    color: var(--text-default-light);
    font-family: var(--Font-Family-Gotham);
	  font-size: var(--Font-Size-Desktop-SM);
    font-style: var(--Font-Style-Normal);
    font-weight: 400;
    line-height: 125%;
  }

  /* =====================================
     Mobile 
  ===================================== */
  @media (max-width: 767px) {

    .cmp-breadcrumb__list {
      row-gap: 4px;
      column-gap: 6px;
      align-items: flex-start;
    }

    .cmp-breadcrumb__item {
      display: flex;
      align-items: center;
    }
  }
